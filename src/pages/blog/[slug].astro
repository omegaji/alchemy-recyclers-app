---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { getPosts, tagLabel, tagSlug, formatDate, readingTime } from '../../utils/blog';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: CollectionEntry<'blog'>; posts: CollectionEntry<'blog'>[] };
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;
const minutes = readingTime(post.body ?? '');
const toc = headings.filter((h) => h.depth === 2);

// Related: most shared tags first.
const related = posts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((r) => r.p);

const url = `${SITE.url}/blog/${post.id}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(cover.src, SITE.url).href,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: `${SITE.url}/` },
  publisher: { '@id': `${SITE.url}/#business` },
  mainEntityOfPage: url,
  keywords: tags.map(tagLabel).join(', '),
  inLanguage: 'en-IN',
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={cover.src}
  schema={[schema]}
  keywords={tags.map(tagLabel)}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <PageHero
    title={title}
    lead={description}
    crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label: title, href: `/blog/${post.id}/` },
    ]}
  >
    <div class="meta">
      <span><Icon name="calendar" size={16} /> <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
      <span><Icon name="clock" size={16} /> {minutes} min read</span>
    </div>
  </PageHero>

  <div class="container">
    <div class="cover">
      <Image src={cover} alt={coverAlt} widths={[700, 1200]} sizes="(min-width: 1100px) 1100px, 100vw" loading="eager" />
    </div>
  </div>

  <section class="section article-wrap">
    <div class="container layout">
      <article class="prose">
        <Content />
        <div class="post-tags">
          <Icon name="tag" size={18} />
          {tags.map((t) => <a class="chip" href={`/blog/tags/${tagSlug(t)}/`}>{tagLabel(t)}</a>)}
        </div>
      </article>

      <aside class="side">
        {
          toc.length > 1 && (
            <nav class="card toc" aria-label="On this page">
              <p class="side-title">On this page</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="card help">
          <p class="side-title">Need help with e-waste?</p>
          <p>Talk to our team in Vadodara.</p>
          <a class="btn btn-gold" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
          <a class="btn btn-ghost" href="/contact/">Send enquiry</a>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section bg-alt">
        <div class="container">
          <h2 class="rel-title">Keep reading</h2>
          <div class="grid grid-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTA />
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 24px;
    font-size: 0.92rem;
    color: #b9c9be;
  }
  .meta span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .cover {
    margin-top: clamp(-48px, -5vw, -24px);
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 21 / 9;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-wrap {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .layout {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1040px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
  .prose > :global(h2:first-child) {
    margin-top: 0;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .post-tags .chip {
    text-decoration: none;
  }
  .side {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  @media (min-width: 1040px) {
    .side {
      position: sticky;
      top: 100px;
    }
  }
  .side-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-700);
    margin-bottom: 12px;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
    font-size: 0.93rem;
  }
  .toc a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--green-700);
  }
  .help {
    display: grid;
    gap: 10px;
  }
  .help p:not(.side-title) {
    color: var(--muted);
    margin: 0 0 6px;
  }
  .rel-title {
    margin-bottom: 32px;
  }
</style>

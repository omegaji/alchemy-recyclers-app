---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, MATERIALS, SERVICES } from '../data/site';
import heroImg from '../assets/img/circuit-board.jpg';

const materialOptions = [...new Set([...MATERIALS.map((m) => m.name), ...SERVICES.map((s) => s.name)])];
---

<BaseLayout
  title="Contact Us – E-Waste Recycler in Vadodara, Gujarat"
  description={`Contact Alchemy Recyclers, Manjusar, Savli, Vadodara, Gujarat. Call ${SITE.phone} or email ${SITE.email} for e-waste recycling and precious metal recovery quotes.`}
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Alchemy Recyclers', about: { '@id': `${SITE.url}/#business` } }]}
>
  <PageHero
    eyebrow="Contact us"
    title="Let’s talk about your <em>scrap</em>."
    lead="Tell us what material you have and roughly how much. Photos help us give you a faster, more accurate answer."
    crumbs={[{ label: 'Contact', href: '/contact/' }]}
    image={heroImg}
  />

  <section class="section">
    <div class="container layout">
      <div class="info">
        <a class="info-card card" href={SITE.phoneHref}>
          <span class="i"><Icon name="phone" size={22} /></span>
          <span><strong>Call us</strong>{SITE.phone}</span>
        </a>
        <a class="info-card card" href={SITE.whatsappHref} target="_blank" rel="noopener">
          <span class="i wa"><Icon name="whatsapp" size={22} /></span>
          <span><strong>WhatsApp</strong>Send photos of your material</span>
        </a>
        <a class="info-card card" href={`mailto:${SITE.email}`}>
          <span class="i"><Icon name="mail" size={22} /></span>
          <span><strong>Email</strong>{SITE.email}</span>
        </a>
        <a class="info-card card" href={SITE.mapLink} target="_blank" rel="noopener">
          <span class="i"><Icon name="pin" size={22} /></span>
          <span>
            <strong>Plant address</strong>
            {SITE.address.street},<br />
            {SITE.address.locality} - {SITE.address.postalCode}, {SITE.address.region}, India
          </span>
        </a>
        <a class="info-card card" href={SITE.brochure} download>
          <span class="i"><Icon name="download" size={22} /></span>
          <span><strong>Brochure</strong>Download our company brochure (PDF)</span>
        </a>
      </div>

      <form class="form card" id="enquiry" novalidate>
        <h2>Send an enquiry</h2>
        <p class="hint">Your message opens in WhatsApp or your email app, ready to send.</p>

        <div class="fields">
          <label>
            <span>Your name *</span>
            <input name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Company</span>
            <input name="company" autocomplete="organization" />
          </label>
          <label>
            <span>Phone *</span>
            <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" />
          </label>
          <label>
            <span>City</span>
            <input name="city" autocomplete="address-level2" placeholder="e.g. Vadodara" />
          </label>
          <label>
            <span>Material type</span>
            <select name="material">
              <option value="">Select…</option>
              {materialOptions.map((m) => <option>{m}</option>)}
              <option>Other / not sure</option>
            </select>
          </label>
          <label>
            <span>Approx. quantity</span>
            <input name="quantity" placeholder="e.g. 200 kg" />
          </label>
          <label class="full">
            <span>Message</span>
            <textarea name="message" rows="5" placeholder="Describe your material…"></textarea>
          </label>
        </div>

        <p class="error" role="alert" hidden>Please enter your name and phone number.</p>

        <div class="btn-row">
          <button class="btn btn-gold" type="submit" data-via="whatsapp"><Icon name="whatsapp" /> Send on WhatsApp</button>
          <button class="btn btn-ghost" type="submit" data-via="email"><Icon name="mail" /> Send by email</button>
        </div>
      </form>
    </div>
  </section>

  <section class="map-wrap">
    <iframe
      src={SITE.mapEmbed}
      title="Map showing Alchemy Recyclers at Manjusar, Savli, Vadodara"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </section>
</BaseLayout>

<script define:vars={{ phone: '917878974409', email: SITE.email }}>
  const form = document.getElementById('enquiry');
  const error = form.querySelector('.error');
  let via = 'whatsapp';
  form.querySelectorAll('button[data-via]').forEach((b) => b.addEventListener('click', () => (via = b.dataset.via)));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form));
    if (!d.name.trim() || !d.phone.trim()) {
      error.hidden = false;
      return;
    }
    error.hidden = true;
    const lines = [
      'Hello Alchemy Recyclers, I have an enquiry.',
      `Name: ${d.name}`,
      d.company && `Company: ${d.company}`,
      `Phone: ${d.phone}`,
      d.city && `City: ${d.city}`,
      d.material && `Material: ${d.material}`,
      d.quantity && `Quantity: ${d.quantity}`,
      d.message && `Message: ${d.message}`,
    ].filter(Boolean);
    const text = lines.join('\n');
    if (via === 'email') {
      const subject = `Enquiry from ${d.name}${d.company ? ` (${d.company})` : ''}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
    } else {
      window.open(`https://wa.me/${phone}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    }
  });
</script>

<style>
  .layout {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  @media (min-width: 980px) {
    .layout {
      grid-template-columns: 380px 1fr;
    }
  }
  .info {
    display: grid;
    gap: 14px;
  }
  .info-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 22px;
    text-decoration: none;
  }
  .info-card strong {
    display: block;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .info-card > span:last-child {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .i {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--green-800);
    color: var(--gold-400);
  }
  .i.wa {
    background: #1fa855;
    color: #fff;
  }
  .form h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 6px;
  }
  .hint {
    color: var(--muted);
    margin-bottom: 26px;
  }
  .fields {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
    margin-bottom: 24px;
  }
  @media (min-width: 640px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .full {
      grid-column: 1 / -1;
    }
  }
  label span {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--ink-2);
  }
  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--green-600);
    box-shadow: 0 0 0 4px rgb(21 128 61 / 12%);
    background: var(--white);
  }
  textarea {
    resize: vertical;
  }
  .error {
    color: #b42318;
    font-weight: 600;
  }
  .map-wrap {
    height: clamp(320px, 45vw, 480px);
    filter: saturate(0.9);
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

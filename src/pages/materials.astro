---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { MATERIALS } from '../data/site';
import heroImg from '../assets/img/e-scrap.webp';
---

<BaseLayout
  title="Materials We Accept: ICs, PCBs & E-Scrap"
  description="Alchemy Recyclers, Vadodara accepts plastic ICs, circuit boards, memory cards, thin films, e-scrap, medical devices, rags & wipes and manufacturing waste for precious metal recovery in Gujarat."
  keywords={['sell IC scrap Gujarat', 'PCB scrap buyer Vadodara', 'memory card scrap', 'e-scrap recycling']}
>
  <PageHero
    eyebrow="What we accept"
    title="Types of recyclable <em>products & materials</em>"
    lead="The Alchemy system is built to process these materials. Not sure if yours qualifies? Send us a photo and we will tell you."
    crumbs={[{ label: 'Materials', href: '/materials/' }]}
    image={heroImg}
  />

  <nav class="jump container" aria-label="Materials on this page">
    {MATERIALS.map((m) => <a class="chip" href={`#${m.slug}`}>{m.name}</a>)}
  </nav>

  <section class="section">
    <div class="container items">
      {
        MATERIALS.map((m, i) => (
          <article id={m.slug} class:list={['item reveal', { flip: i % 2 === 1 }]}>
            <div class="img-frame">
              <Image src={m.image} alt={m.imageAlt} widths={[500, 900]} sizes="(min-width: 900px) 45vw, 100vw" />
            </div>
            <div>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h2>{m.name}</h2>
              <p class="lead">{m.summary}</p>
              <h3 class="sub">Common sources</h3>
              <ul class="tick-list cols">
                {m.sources.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CTA title="Have a lot of any of these?" text="Share photos and an approximate quantity on WhatsApp or email and we will get back to you." />
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 28px;
  }
  .items {
    display: grid;
    gap: clamp(56px, 8vw, 100px);
  }
  .item {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    scroll-margin-top: 100px;
  }
  @media (min-width: 900px) {
    .item {
      grid-template-columns: 1fr 1fr;
    }
    .item.flip .img-frame {
      order: 2;
    }
  }
  .img-frame {
    aspect-ratio: 4 / 3;
  }
  .n {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--gold-600);
  }
  h2 {
    margin-top: 4px;
  }
  .sub {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-700);
    margin: 24px 0 14px;
  }
  .cols {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    column-gap: 24px;
  }
</style>

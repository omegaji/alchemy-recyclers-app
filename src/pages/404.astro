---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="nf">
    <div class="container">
      <p class="code">404</p>
      <h1>This page has been <span class="gold-text">recycled.</span></h1>
      <p class="lead">We could not find the page you were looking for. Try one of these instead:</p>
      <div class="btn-row center">
        <a class="btn btn-gold" href="/">Home <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="/services/">Services</a>
        <a class="btn btn-ghost" href="/blog/">Blog</a>
        <a class="btn btn-ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    padding: clamp(80px, 14vw, 160px) 0;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .center {
    justify-content: center;
  }
</style>

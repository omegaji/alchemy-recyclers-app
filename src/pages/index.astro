---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MetalTiles from '../components/MetalTiles.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import PostCard from '../components/PostCard.astro';
import SDGs from '../components/SDGs.astro';
import { SITE, MATERIALS, SERVICES, FAQS } from '../data/site';
import { getPosts } from '../utils/blog';
import hero from '../assets/img/hero-gold-cpus.png';

const posts = (await getPosts()).slice(0, 3);

const steps = [
  { icon: 'scale', title: 'Collect & assess', text: 'We receive your material and identify the key raw materials in it.' },
  { icon: 'sort', title: 'Sort & segregate', text: 'Items are separated into individual lots and treated batch by batch.' },
  { icon: 'flame', title: 'Thermal reduction', text: 'Organics are reduced to a metal-rich ash, with full emission control.' },
  { icon: 'chip', title: 'Recover & refine', text: 'Crushing, sizing, blending and solvent extraction recover the metals.' },
] as const;
---

<BaseLayout
  title="E-Waste Recycling in Vadodara, Gujarat | Alchemy Recyclers"
  description="Alchemy Recyclers is an e-waste recycling and precious metal recovery company in Vadodara, Gujarat. We recover gold, silver, platinum, palladium, rhodium and copper from e-waste, ICs, memory cards and industrial waste."
  keywords={['e-waste recycling near me', 'e-waste management Vadodara', 'e-waste disposal Gujarat', 'PCB recycling Gujarat']}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">E-waste recycling · Vadodara, Gujarat</p>
        <h1>In e-waste, all that glitters is <span class="gold-text">indeed gold.</span></h1>
        <p class="lead">
          We recycle electronic and industrial waste and recover gold, silver, platinum, palladium, rhodium and copper,
          from our plant in Manjusar, Savli, Vadodara.
        </p>
        <div class="btn-row on-dark">
          <a class="btn btn-gold" href="/contact/">Get a quote <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="/services/">Explore services</a>
        </div>
        <dl class="hero-stats">
          <div><dt>20+</dt><dd>years in the scrap trade</dd></div>
          <div><dt>6</dt><dd>metals recovered</dd></div>
          <div><dt>1100 °C</dt><dd>afterburner for clean exhaust</dd></div>
        </dl>
      </div>

      <div class="hero-visual">
        <div class="img-frame">
          <Image
            src={hero}
            alt="Gold recovered from old computer processors held in a gloved hand"
            widths={[600, 900, 1270]}
            sizes="(min-width: 960px) 560px, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="float-card">
          <span class="big">30×</span>
          <span>more gold in a tonne of phone circuit boards than in a tonne of gold ore</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Materials marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [...Array(2)].map(() => (
          <>
            {['Plastic ICs', 'Circuit boards', 'Memory cards', 'Thin films', 'E-scrap', 'Medical devices', 'Rags & wipes', 'Jewellery waste', 'Spent catalysts', 'Plating waste'].map((t) => (
              <span>
                {t}
                <i />
              </span>
            ))}
          </>
        ))
      }
    </div>
  </div>

  <!-- Urban mine -->
  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">The urban mine</p>
        <h2>Your old electronics are richer than a gold mine.</h2>
        <p class="lead">
          E-waste can hold precious metals 40 to 50 times richer than ore dug from the ground. We call it the urban
          mine, and we help Gujarat’s businesses recover its value.
        </p>
        <p>
          Recovering these metals locally also helps India. We are a net importer of gold, so every gram recovered here
          saves foreign exchange and keeps rare, non-renewable metals in use.
        </p>
        <a class="link-arrow" href="/blog/how-gold-is-recovered-from-e-waste/">How gold is recovered from e-waste <Icon name="arrow" size={18} /></a>
      </div>

      <div class="compare card reveal" role="img" aria-label="Gold yield: about 5 grams per tonne of gold ore versus about 150 grams per tonne of phone circuit boards">
        <p class="compare-title">Gold yield per tonne</p>
        <div class="bar-row">
          <span class="bar-label">Gold ore</span>
          <div class="bar"><span style="width:3.3%"></span></div>
          <span class="bar-val">≈ 5 g</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Phone PCBs</span>
          <div class="bar"><span class="gold" style="width:100%"></span></div>
          <span class="bar-val">≈ 150 g</span>
        </div>
        <p class="compare-note">Typical figures. Actual yield depends on the type and grade of material.</p>
      </div>
    </div>
  </section>

  <!-- Metals -->
  <section class="section bg-dark metals-section">
    <div class="container">
      <div class="section-head center reveal">
        <p class="eyebrow">Metals we recover</p>
        <h2>Six valuable metals, back into the economy.</h2>
        <p class="lead">
          Our thermal reduction system with state-of-the-art pollution control turns even low-grade waste into
          marketable precious metals.
        </p>
      </div>
      <MetalTiles />
    </div>
  </section>

  <!-- Materials -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What we accept</p>
        <h2>Types of recyclable products and materials</h2>
        <p class="lead">From single chips to truckloads of e-scrap. If it carries precious metal, we can likely process it.</p>
      </div>
      <div class="materials">
        {
          MATERIALS.map((m, i) => (
            <a href={`/materials/#${m.slug}`} class:list={['mat reveal', { wide: i === 0 }]}>
              <Image src={m.image} alt={m.imageAlt} widths={[400, 800]} sizes="(min-width: 900px) 40vw, 100vw" />
              <div class="mat-body">
                <h3>{m.name}</h3>
                <p>{m.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section bg-alt">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our services</p>
        <h2>Recycling and recovery for every kind of precious-metal waste</h2>
      </div>
      <div class="grid grid-3">
        {
          SERVICES.map((s, i) => (
            <a href={`/services/${s.slug}/`} class="card service reveal">
              <span class="svc-num">0{i + 1}</span>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
              <span class="link-arrow">
                Learn more <Icon name="arrow" size={18} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">How we recycle</p>
        <h2>Green technology, proven process</h2>
        <p class="lead">
          Thermal reduction is the long-standing industry standard for recycling precious metals from organic-rich
          material. We combine it with solvent extraction and multi-stage exhaust scrubbing.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="step-icon">
                <Icon name={s.icon} size={26} />
              </span>
              <span class="step-n">Step {i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="center-link"><a class="btn btn-ghost" href="/process/">See our full process <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- SDGs -->
  <section class="section bg-alt">
    <div class="container">
      <div class="section-head center reveal">
        <p class="eyebrow">Our green pledge</p>
        <h2>We aid the United Nations Sustainable Development Goals</h2>
      </div>
      <SDGs />
    </div>
  </section>

  <!-- Blog -->
  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="blog-head reveal">
            <div>
              <p class="eyebrow">From the blog</p>
              <h2>Guides on e-waste in Gujarat</h2>
            </div>
            <a class="btn btn-ghost" href="/blog/">
              All articles <Icon name="arrow" />
            </a>
          </div>
          <div class="grid grid-3">
            {posts.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="section bg-alt">
    <div class="container split faq-split">
      <div class="reveal">
        <p class="eyebrow">FAQ</p>
        <h2>Questions we hear often</h2>
        <p class="lead">Can’t find your answer? Call us on <a href={SITE.phoneHref}>{SITE.phone}</a>.</p>
      </div>
      <FAQ items={FAQS} />
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--green-950);
    color: #cfdcd3;
    padding: clamp(56px, 8vw, 110px) 0 clamp(72px, 10vw, 130px);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(45% 60% at 80% 30%, rgb(212 160 23 / 28%), transparent 70%),
      radial-gradient(40% 60% at 10% 90%, rgb(31 157 76 / 25%), transparent 70%),
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px) 0 0 / 48px 48px;
  }
  .hero-grid {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    font-weight: 500;
  }
  .hero .eyebrow {
    color: var(--gold-400);
  }
  .hero .lead {
    color: #b9c9be;
    max-width: 52ch;
    margin-bottom: 2rem;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 44px);
    margin: 44px 0 0;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 10%);
  }
  .hero-stats dt {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 600;
    color: var(--gold-400);
    line-height: 1.1;
  }
  .hero-stats dd {
    margin: 4px 0 0;
    font-size: 0.9rem;
    max-width: 16ch;
  }
  .hero-visual {
    position: relative;
  }
  .hero-visual .img-frame {
    aspect-ratio: 4 / 3.4;
    border: 1px solid rgb(236 201 75 / 30%);
    transform: rotate(1.5deg);
  }
  .float-card {
    position: absolute;
    left: clamp(-8px, -2vw, -28px);
    bottom: -28px;
    max-width: 270px;
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgb(251 250 246 / 96%);
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.4;
    box-shadow: var(--shadow-lg);
    animation: floaty 6s ease-in-out infinite;
  }
  .float-card .big {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes floaty {
    50% {
      transform: translateY(-8px);
    }
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    background: var(--gold-grad);
    color: var(--green-950);
    padding: 14px 0;
    white-space: nowrap;
  }
  .track {
    display: inline-flex;
    animation: scroll 40s linear infinite;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .track i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green-800);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Compare */
  .compare {
    padding: clamp(24px, 4vw, 40px);
  }
  .compare-title {
    font-weight: 700;
    margin-bottom: 24px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 96px 1fr 64px;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
  }
  .bar-label {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .bar {
    height: 18px;
    border-radius: 999px;
    background: var(--paper-2);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    min-width: 6px;
    border-radius: 999px;
    background: var(--muted);
  }
  .bar span.gold {
    background: var(--gold-grad);
  }
  .bar-val {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    text-align: right;
  }
  .compare-note {
    margin: 12px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 650;
    color: var(--green-700);
    text-decoration: none;
  }
  .link-arrow :global(svg) {
    transition: transform 0.2s;
  }
  a:hover > .link-arrow :global(svg),
  .link-arrow:hover :global(svg) {
    transform: translateX(4px);
  }

  .metals-section {
    background:
      radial-gradient(60% 50% at 50% 0%, rgb(212 160 23 / 18%), transparent 70%),
      var(--green-950);
  }

  /* Materials bento */
  .materials {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .materials {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .materials {
      grid-template-columns: repeat(4, 1fr);
    }
    .mat.wide {
      grid-column: span 2;
    }
  }
  .mat {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 300px;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--white);
    isolation: isolate;
  }
  .mat img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.7s ease;
  }
  .mat::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(6 24 15 / 5%) 20%, rgb(6 24 15 / 88%) 100%);
  }
  .mat:hover img {
    transform: scale(1.06);
  }
  .mat-body {
    padding: 22px;
  }
  .mat h3 {
    color: var(--white);
    margin-bottom: 6px;
  }
  .mat p {
    font-size: 0.92rem;
    color: #d5e0d8;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Services */
  .service {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .service p {
    color: var(--muted);
  }
  .service .link-arrow {
    margin-top: auto;
  }
  .svc-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 18px;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    counter-reset: s;
  }
  .steps li {
    position: relative;
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .steps p {
    color: var(--muted);
    margin: 0;
  }
  .step-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--green-800);
    color: var(--gold-400);
    margin-bottom: 18px;
  }
  .step-n {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin-bottom: 6px;
  }
  .center-link {
    text-align: center;
    margin: 40px 0 0;
  }

  .blog-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 40px;
  }
  .faq-split {
    align-items: start;
  }
  .faq-split .lead a {
    color: var(--green-700);
    font-weight: 600;
  }
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="topbar">
  <div class="container topbar-inner">
    <span class="loc"><Icon name="pin" size={15} /> Manjusar, Savli, Vadodara, Gujarat</span>
    <div class="topbar-links">
      <a href={SITE.phoneHref}><Icon name="phone" size={15} /> {SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}><Icon name="mail" size={15} /> {SITE.email}</a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container header-inner">
    <Logo />

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.filter((n) => n.href !== '/contact/').map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-cta">
      <a href="/contact/" class="btn btn-gold">Get a quote <Icon name="arrow" size={16} /></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Open menu</span>
        <Icon name="menu" size={26} class="i-open" />
        <Icon name="close" size={26} class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-contact">
        <a class="btn btn-gold" href={SITE.phoneHref}><Icon name="phone" /> Call {SITE.phone}</a>
        <a class="btn btn-ghost" href={SITE.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topbar {
    background: var(--green-950);
    color: #b9c9be;
    font-size: 0.84rem;
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 40px;
  }
  .topbar a,
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .topbar a:hover {
    color: var(--gold-400);
  }
  .topbar-links {
    display: flex;
    gap: 22px;
  }
  @media (max-width: 760px) {
    .loc {
      display: none;
    }
    .topbar-inner {
      justify-content: center;
    }
    .topbar-links a:last-child {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 250 246 / 82%);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .site-header.scrolled {
    border-color: var(--line);
    box-shadow: 0 6px 24px -12px rgb(6 24 15 / 18%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 74px;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    display: block;
    padding: 8px 14px;
    font-weight: 550;
    font-size: 0.97rem;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav a:hover {
    color: var(--green-700);
    background: var(--green-50);
  }
  .nav a[aria-current='page'] {
    color: var(--green-700);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 18px;
    height: 3px;
    margin-left: -9px;
    border-radius: 3px;
    background: var(--gold-grad);
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    color: var(--ink);
    cursor: pointer;
  }
  .menu-btn :global(.i-close),
  .menu-btn[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .menu-btn[aria-expanded='true'] :global(.i-close) {
    display: block;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - 74px);
    background: var(--paper);
    overflow-y: auto;
    padding: 12px var(--gutter) 80px;
    border-top: 1px solid var(--line);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 4px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu li a[aria-current='page'] {
    color: var(--green-600);
  }
  .mobile-contact {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  @media (max-width: 1020px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .header-cta .btn {
      display: none;
    }
  }
</style>

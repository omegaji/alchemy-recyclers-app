---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a href="/" class:list={['logo', { light }]} aria-label="Alchemy Recyclers home">
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
    <defs>
      <linearGradient id="lg-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f8e6a0" />
        <stop offset=".5" stop-color="#d4a017" />
        <stop offset="1" stop-color="#f3d77a" />
      </linearGradient>
    </defs>
    <path d="M20 2 36 11v18L20 38 4 29V11z" fill="#14532d" />
    <path d="M20 2 36 11v18L20 38 4 29V11z" fill="none" stroke="url(#lg-gold)" stroke-width="2" />
    <text x="20" y="26" text-anchor="middle" font-family="Georgia, serif" font-size="15" font-weight="700" fill="url(#lg-gold)">Au</text>
  </svg>
  <span class="word"><span class="a">Alchemy</span><span class="r">Recyclers</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1;
  }
  .mark {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .word {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }
  .a {
    color: var(--green-600);
  }
  .r {
    color: var(--ink);
  }
  .light .a {
    color: var(--gold-400);
  }
  .light .r {
    color: var(--white);
  }
</style>
